{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vite",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "3000",
        "--strictPort"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "vercel-dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vercel",
        "dev",
        "--yes"
      ],
      "port": 3000,
      "autoPort": true
    }
  ]
}
